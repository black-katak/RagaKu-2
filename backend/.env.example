# RagaKu backend environment (server-only; never ship these in the app).

# --- OpenRouter (PRD F5) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=https://github.com/black-katak/RagaKu-2
OPENROUTER_APP_TITLE=RagaKu

# AI behaviour
AI_MAX_RETRIES=1

# --- Measurement service (PRD F3) ---
# Command template run per request. {image} and {height} are substituted.
# Example (Docker): docker run --rm -v /tmp:/tmp ragaku-measure python3 inference.py -i {image} -ht {height}
# Example (local):  python3 inference.py -i {image} -ht {height}
MEASUREMENT_COMMAND=
MEASUREMENT_TIMEOUT_SECONDS=120

# --- CORS ---
CORS_ALLOW_ORIGINS=*
