# RagaKu backend environment (server-only; never ship these in the app).

# --- OpenRouter (PRD F5) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=https://github.com/black-katak/RagaKu-2
OPENROUTER_APP_TITLE=RagaKu

# AI behaviour
AI_MAX_RETRIES=1

# --- CORS ---
CORS_ALLOW_ORIGINS=*

# --- Gemini body estimation (F3: height/weight from photo) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when GEMINI_MODEL is overloaded (503/429). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
